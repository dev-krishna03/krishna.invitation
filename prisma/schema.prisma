generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ enums ============

enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  USER
}

enum OrgMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum SubscriptionStatus {
  NONE
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum TemplateCategory {
  LUXURY
  MINIMAL
  TRADITIONAL
  MODERN
  FLORAL
  RUSTIC
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum PlanType {
  INDIVIDUAL
  COMPANY
}

enum CreatorPlanTier {
  FREE
  PRO
  STUDIO
  ZERO_FEE
  ENTERPRISE
  CUSTOM
}

enum TemplateSource {
  PLATFORM
  USER_CREATED
  USER_IMPORTED
  USER_UPLOADED
  FROM_INVITATION
}

enum ModerationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  TAKEN_DOWN
}

enum Currency {
  INR
  USD
}

enum RsvpStatus {
  PENDING
  ACCEPTED
  DECLINED
  MAYBE
}

enum Gateway {
  RAZORPAY
  CASHFREE
  PHONEPE
  STRIPE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum SubStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum Environment {
  TEST
  LIVE
}

enum TestStatus {
  PASS
  FAIL
}

enum CouponType {
  PERCENTAGE
  FIXED
}

// ============ models ============

model User {
  id              String   @id @default(uuid()) @db.Uuid
  email           String   @unique
  name            String?
  role            UserRole @default(USER)
  avatar_url      String?
  locale          String   @default("en")
  referral_code   String   @unique
  referred_by_id  String?  @db.Uuid
  referral_credit Int      @default(0)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  referred_by  User?          @relation("Referrals", fields: [referred_by_id], references: [id])
  referrals    User[]         @relation("Referrals")
  memberships  OrgMember[]
  invitations  Invitation[]
  payments     Payment[]
  audit_logs   AuditLog[]
  gateways     PaymentGateway[]     @relation("GatewayUpdatedBy")
  integrations IntegrationCredential[] @relation("IntegrationUpdatedBy")
  settings     SiteSetting[]        @relation("SettingUpdatedBy")
  owned_templates      Template[]   @relation("TemplateOwner")
  creator_subscription UserCreatorSubscription?
  template_purchases   TemplatePurchase[]
  policies_updated     Policy[]     @relation("PolicyUpdatedBy")
  templates_reviewed   Template[]   @relation("TemplateReviewer")
  preferred_currency   Currency    @default(INR)

  custom_requests   CustomDesignRequest[] @relation("HostDesignRequests")
  design_bids       DesignBid[]           @relation("CreatorDesignBids")
  template_reviews  TemplateReview[]
  affiliate_partner AffiliatePartner?
  creator_strikes   CreatorStrike[]       @relation("CreatorStrikes")
  concierge_orders  ConciergeServiceOrder[]
  payout_profile    CreatorPayoutProfile? @relation("UserPayoutProfile")
  created_coupons   Coupon[]              @relation("CreatorCoupons")
  activity_history  ActivityHistory[]     @relation("UserActivityHistory")
  payout_requests   CreatorPayoutRequest[] @relation("CreatorPayoutRequests")
  uploaded_elements TemplateElement[]     @relation("CreatorElements")

  @@index([referred_by_id])
  @@map("users")
}

model Organization {
  id                  String             @id @default(uuid()) @db.Uuid
  name                String
  slug                String             @unique
  logo_url            String?
  subscription_status SubscriptionStatus @default(NONE)
  is_active           Boolean            @default(true)
  created_at          DateTime           @default(now())

  members       OrgMember[]
  invitations   Invitation[]
  subscriptions Subscription[]
  payments      Payment[]

  @@map("organizations")
}

model OrgMember {
  id         String        @id @default(uuid()) @db.Uuid
  org_id     String        @db.Uuid
  user_id    String        @db.Uuid
  role       OrgMemberRole @default(MEMBER)
  invited_at DateTime?
  joined_at  DateTime?

  org  Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  user User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([org_id, user_id])
  @@map("org_members")
}

model Template {
  id            String           @id @default(uuid()) @db.Uuid
  name          String
  slug          String           @unique
  description   String?
  thumbnail_url String?
  preview_url   String?
  category      TemplateCategory
  event_types   String[]
  is_active     Boolean          @default(true)
  is_featured   Boolean          @default(false)
  sort_order    Int              @default(0)
  created_at    DateTime         @default(now())
  updated_at    DateTime?        @updatedAt

  // ---- Creator-workspace fields ----
  // owner_user_id null = platform template (seeded by the system).
  // owner_user_id set  = template inside a user's workspace (created,
  // imported from another creator, or saved from an invitation).
  owner_user_id              String?        @db.Uuid
  source                     TemplateSource @default(PLATFORM)
  source_invitation_id       String?        @db.Uuid
  imported_from_template_id  String?        @db.Uuid

  // Marketplace settings: the owner chooses whether to list it and at
  // what price. The platform fee % is snapshot on the sale, taken from
  // the owner's active creator plan at that time.
  is_in_marketplace Boolean  @default(false)
  price             Int?
  price_usd         Int?
  currency          Currency @default(INR)
  sales_count       Int      @default(0)
  revenue_total     Int      @default(0)

  // Moderation (super admin review before a user template goes public).
  moderation_status  ModerationStatus @default(DRAFT)
  moderation_notes   String?
  submitted_at       DateTime?
  reviewed_at        DateTime?
  reviewed_by_id     String?         @db.Uuid

  owner                User?               @relation("TemplateOwner", fields: [owner_user_id], references: [id], onDelete: Cascade)
  reviewed_by          User?               @relation("TemplateReviewer", fields: [reviewed_by_id], references: [id], onDelete: SetNull)
  source_invitation    Invitation?         @relation("TemplateFromInvitation", fields: [source_invitation_id], references: [id], onDelete: SetNull)
  imported_from        Template?           @relation("TemplateImport", fields: [imported_from_template_id], references: [id], onDelete: SetNull)
  imports              Template[]          @relation("TemplateImport")
  pricing              TemplatePricing[]
  invitations          Invitation[]
  purchases            TemplatePurchase[]
  reviews              TemplateReview[]
  copyright_reports    CopyrightReport[]
  coupons              Coupon[]            @relation("TemplateCoupons")

  @@index([owner_user_id])
  @@index([is_in_marketplace])
  @@index([moderation_status])
  @@map("templates")
}

model TemplatePricing {
  id            String  @id @default(uuid()) @db.Uuid
  template_id   String  @db.Uuid
  duration_days Int
  price         Int
  currency      String  @default("INR")
  is_active     Boolean @default(true)

  template Template @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@unique([template_id, duration_days])
  @@map("template_pricing")
}

model Invitation {
  id           String    @id @default(uuid()) @db.Uuid
  user_id      String    @db.Uuid
  org_id       String?   @db.Uuid
  template_id  String    @db.Uuid
  slug         String    @unique
  title        String
  event_type   String    @default("wedding")
  locale       String    @default("en")
  data         Json
  music_url    String?
  is_published Boolean   @default(false)
  published_at DateTime?
  expires_at   DateTime?
  view_count   Int       @default(0)

  // Community marketplace + access-limited sharing.
  is_in_community    Boolean   @default(false)
  community_price    Int?
  community_currency String    @default("INR")
  access_limit       Int?
  access_used        Int       @default(0)
  preview_token      String?   @unique
  preview_approved   Boolean   @default(false)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  // Bundle & Host Extras
  bundle_enabled     Boolean   @default(false)
  bundle_type        String?   // "FULL_SUITE" (Save the Date, Invitation, Reminder, Thank You)
  bundle_stage       String    @default("MAIN") // "SAVE_THE_DATE" | "MAIN" | "REMINDER" | "THANK_YOU"
  gift_upi_id        String?
  gift_qr_url        String?
  gift_notes         String?
  wish_wall_enabled  Boolean   @default(true)
  photo_wall_enabled Boolean   @default(true)
  is_protected       Boolean   @default(true)
  supported_locales  String[]  @default(["en", "gu", "hi"])
  font_family        String    @default("inter")

  user     User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  org      Organization?     @relation(fields: [org_id], references: [id], onDelete: SetNull)
  template Template          @relation(fields: [template_id], references: [id])
  events   InvitationEvent[]
  photos   InvitationPhoto[]
  guests   Guest[]
  views    InvitationView[]
  payments Payment[]
  saved_as_templates Template[] @relation("TemplateFromInvitation")
  wishes   GuestWish[]
  concierge_orders ConciergeServiceOrder[]

  @@index([user_id])
  @@index([org_id])
  @@map("invitations")
}

model InvitationEvent {
  id            String   @id @default(uuid()) @db.Uuid
  invitation_id String   @db.Uuid
  name          String
  venue         String?
  address       String?
  map_lat       Float?
  map_lng       Float?
  date          DateTime?
  start_time    String?
  end_time      String?
  sort_order    Int      @default(0)

  invitation Invitation @relation(fields: [invitation_id], references: [id], onDelete: Cascade)

  @@map("invitation_events")
}

model InvitationPhoto {
  id            String  @id @default(uuid()) @db.Uuid
  invitation_id String  @db.Uuid
  url           String
  caption       String?
  sort_order    Int     @default(0)

  invitation Invitation @relation(fields: [invitation_id], references: [id], onDelete: Cascade)

  @@map("invitation_photos")
}

model Guest {
  id             String     @id @default(uuid()) @db.Uuid
  invitation_id  String     @db.Uuid
  name           String
  slug           String
  phone          String?
  email          String?
  group_name     String?
  plus_allowed   Int        @default(0)
  rsvp_status    RsvpStatus @default(PENDING)
  rsvp_at        DateTime?
  rsvp_message   String?
  dietary_notes  String?
  viewed_at      DateTime?

  // Host Extras & Function scoping
  invited_events      String[]   @default([])
  meal_preference     String?
  travel_details      Json?
  is_family           Boolean    @default(false)
  family_members      String[]   @default([])
  plus_count          Int        @default(0)
  dpdp_consent        Boolean    @default(true)
  whatsapp_sent_count Int        @default(0)
  last_reminded_at    DateTime?

  invitation Invitation       @relation(fields: [invitation_id], references: [id], onDelete: Cascade)
  views      InvitationView[]
  wishes     GuestWish[]

  @@unique([invitation_id, slug])
  @@map("guests")
}

model InvitationView {
  id            String   @id @default(uuid()) @db.Uuid
  invitation_id String   @db.Uuid
  guest_id      String?  @db.Uuid
  device_type   String?
  browser       String?
  ip_hash       String?
  viewed_at     DateTime @default(now())

  invitation Invitation @relation(fields: [invitation_id], references: [id], onDelete: Cascade)
  guest      Guest?     @relation(fields: [guest_id], references: [id], onDelete: SetNull)

  @@index([invitation_id])
  @@map("invitation_views")
}

model SubscriptionPlan {
  id               String        @id @default(uuid()) @db.Uuid
  name             String
  slug             String        @unique
  type             PlanType
  max_members      Int?
  max_invitations  Int?
  features         Json
  price            Int
  currency         String        @default("INR")
  billing_period   BillingPeriod
  is_active        Boolean       @default(true)
  sort_order       Int           @default(0)

  subscriptions Subscription[]
  payments      Payment[]

  @@map("subscription_plans")
}

model Subscription {
  id                      String    @id @default(uuid()) @db.Uuid
  org_id                  String    @db.Uuid
  plan_id                 String    @db.Uuid
  status                  SubStatus @default(ACTIVE)
  gateway_subscription_id String?
  current_period_start    DateTime
  current_period_end      DateTime
  created_at              DateTime  @default(now())

  org  Organization     @relation(fields: [org_id], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [plan_id], references: [id])

  @@map("subscriptions")
}

model Payment {
  id                   String        @id @default(uuid()) @db.Uuid
  user_id              String        @db.Uuid
  org_id               String?       @db.Uuid
  invitation_id        String?       @db.Uuid
  subscription_plan_id String?       @db.Uuid
  gateway              Gateway
  gateway_order_id     String?
  gateway_payment_id   String?
  amount               Int
  currency             String        @default("INR")
  status               PaymentStatus @default(PENDING)
  coupon_id            String?       @db.Uuid
  discount_amount      Int           @default(0)
  metadata             Json?
  created_at           DateTime      @default(now())
  updated_at           DateTime      @updatedAt

  user         User              @relation(fields: [user_id], references: [id])
  org          Organization?     @relation(fields: [org_id], references: [id])
  invitation   Invitation?       @relation(fields: [invitation_id], references: [id])
  plan         SubscriptionPlan? @relation(fields: [subscription_plan_id], references: [id])
  coupon       Coupon?           @relation(fields: [coupon_id], references: [id])

  @@index([user_id])
  @@index([status])
  @@map("payments")
}

model PaymentGateway {
  id             String      @id @default(uuid()) @db.Uuid
  name           Gateway     @unique
  slug           String      @unique
  display_name   String
  is_active      Boolean     @default(false)
  credentials    Json
  environment    Environment @default(TEST)
  webhook_secret String?
  updated_by_id  String?     @db.Uuid
  updated_at     DateTime    @updatedAt

  updated_by User? @relation("GatewayUpdatedBy", fields: [updated_by_id], references: [id])

  @@map("payment_gateways")
}

model IntegrationCredential {
  id             String       @id @default(uuid()) @db.Uuid
  service_name   String
  service_slug   String       @unique
  display_name   String
  credentials    Json
  is_configured  Boolean      @default(false)
  is_active      Boolean      @default(false)
  environment    Environment  @default(TEST)
  last_tested_at DateTime?
  test_status    TestStatus?
  updated_by_id  String?      @db.Uuid
  updated_at     DateTime     @updatedAt

  updated_by User? @relation("IntegrationUpdatedBy", fields: [updated_by_id], references: [id])

  @@map("integration_credentials")
}

model SiteSetting {
  id            String   @id @default(uuid()) @db.Uuid
  key           String   @unique
  value         Json
  updated_by_id String?  @db.Uuid
  updated_at    DateTime @updatedAt

  updated_by User? @relation("SettingUpdatedBy", fields: [updated_by_id], references: [id])

  @@map("site_settings")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actor_id    String?  @db.Uuid
  action      String
  entity_type String
  entity_id   String?
  old_value   Json?
  new_value   Json?
  ip_address  String?
  created_at  DateTime @default(now())

  actor User? @relation(fields: [actor_id], references: [id])

  @@index([entity_type, entity_id])
  @@index([actor_id])
  @@map("audit_logs")
}

model EventTypeConfig {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  labels      Json     @default("{}")
  icon        String?
  parent_id   String?  @db.Uuid
  is_active   Boolean  @default(true)
  is_featured Boolean  @default(false)
  sort_order  Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  parent   EventTypeConfig?  @relation("EventTypeChildren", fields: [parent_id], references: [id], onDelete: SetNull)
  children EventTypeConfig[] @relation("EventTypeChildren")

  @@index([parent_id])
  @@map("event_types")
}

model CreatorPlan {
  id                 String           @id @default(uuid()) @db.Uuid
  slug               String           @unique
  name               String
  tier               CreatorPlanTier  @default(PRO)
  tagline            String?
  monthly_price      Int              @default(0)
  yearly_price       Int              @default(0)
  currency           String           @default("INR")
  // Marketplace limits
  max_templates_free     Int?             @default(5) // First 5 templates create/add free
  extra_template_price   Int              @default(99) // Price in INR per additional template slot
  max_templates_for_sale Int?         // null = unlimited
  max_live_invitations   Int?         // null = unlimited
  platform_fee_pct       Int          @default(20)
  // Capability flags
  can_sell               Boolean      @default(false)
  can_import_community   Boolean      @default(true)
  white_label            Boolean      @default(false)
  features               Json         @default("[]")
  is_active              Boolean      @default(true)
  sort_order             Int          @default(0)

  subscriptions UserCreatorSubscription[]

  @@map("creator_plans")
}

model UserCreatorSubscription {
  id         String              @id @default(uuid()) @db.Uuid
  user_id    String              @unique @db.Uuid
  plan_id    String              @db.Uuid
  status     SubscriptionStatus  @default(ACTIVE)
  billing    BillingPeriod       @default(MONTHLY)
  period_start DateTime          @default(now())
  period_end   DateTime?
  created_at   DateTime          @default(now())

  user User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  plan CreatorPlan @relation(fields: [plan_id], references: [id])

  @@map("user_creator_subscriptions")
}

model TemplatePurchase {
  id               String   @id @default(uuid()) @db.Uuid
  template_id      String   @db.Uuid
  buyer_user_id    String   @db.Uuid
  gross_amount     Int
  platform_fee     Int
  seller_amount    Int
  currency         Currency @default(INR)
  copy_template_id String?  @db.Uuid
  created_at       DateTime @default(now())

  template Template @relation(fields: [template_id], references: [id])
  buyer    User     @relation(fields: [buyer_user_id], references: [id])

  @@index([template_id])
  @@index([buyer_user_id])
  @@map("template_purchases")
}

enum ElementKind {
  TEXT
  HEADING
  NAMES
  MESSAGE
  BUTTON
  DIVIDER
  MOTIF
  IMAGE
  QRCODE
  BADGE
  COUNTDOWN
  MAP
  MUSIC
  VIDEO
  GALLERY
  RSVP
  SOCIAL
  CONTAINER
}

model TemplateElement {
  id            String      @id @default(uuid()) @db.Uuid
  slug          String      @unique
  name          String
  kind          ElementKind
  category      String      @default("basic")
  icon          String?
  description   String?
  default_props Json        @default("{}")
  is_pro_only   Boolean     @default(false)
  is_active     Boolean     @default(true)
  sort_order    Int         @default(0)

  // Creator Ownership & Multi-format File Asset
  owner_user_id String?     @db.Uuid
  file_url      String?
  file_format   String?     // "SVG" | "PNG" | "JPG" | "JPEG" | "GIF" | "MP4" | "MOV" | "WEBM" | "MP3" | "M4A" | "WAV"
  file_size     Int?        // File size in bytes
  media_type    String?     // "IMAGE" | "VECTOR" | "VIDEO" | "AUDIO"

  owner         User?       @relation("CreatorElements", fields: [owner_user_id], references: [id], onDelete: Cascade)

  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt

  @@index([is_active])
  @@index([category])
  @@index([owner_user_id])
  @@index([file_format])
  @@map("template_elements")
}

model Policy {
  id            String   @id @default(uuid()) @db.Uuid
  slug          String   @unique
  title         String
  summary       String?
  content       String
  version       String   @default("1.0")
  is_published  Boolean  @default(true)
  effective_at  DateTime @default(now())
  updated_by_id String?  @db.Uuid
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  updated_by User? @relation("PolicyUpdatedBy", fields: [updated_by_id], references: [id], onDelete: SetNull)

  @@map("policies")
}

model Coupon {
  id                  String     @id @default(uuid()) @db.Uuid
  code                String     @unique
  name                String?
  type                CouponType
  value               Int
  max_uses            Int?
  used_count          Int        @default(0)
  max_uses_per_user   Int?       @default(1)
  min_amount          Int?
  max_discount_amount Int?
  first_time_only     Boolean    @default(false)
  allowed_user_emails String[]   @default([])
  allowed_days_of_week Int[]     @default([])
  time_start          String?
  time_end            String?
  scope               String     @default("ALL") // "ALL", "ADMIN_TEMPLATES", "CREATOR_TEMPLATES", "SPECIFIC_TEMPLATE", "CATEGORY"
  category_filter     String?
  valid_from          DateTime?
  valid_until         DateTime?
  is_active           Boolean    @default(true)
  created_at          DateTime   @default(now())

  creator_user_id String?    @db.Uuid
  template_id     String?    @db.Uuid

  creator  User?     @relation("CreatorCoupons", fields: [creator_user_id], references: [id], onDelete: SetNull)
  template Template? @relation("TemplateCoupons", fields: [template_id], references: [id], onDelete: SetNull)
  payments Payment[]

  @@index([creator_user_id])
  @@index([template_id])
  @@index([scope])
  @@map("coupons")
}

model CreatorPayoutProfile {
  id                  String   @id @default(uuid()) @db.Uuid
  user_id             String   @unique @db.Uuid
  account_holder_name String
  bank_name           String
  account_number      String
  ifsc_code           String
  upi_id              String?
  pan_number          String?
  payout_preference   String   @default("BANK") // "BANK" or "UPI"
  is_verified         Boolean  @default(true)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  user User @relation("UserPayoutProfile", fields: [user_id], references: [id], onDelete: Cascade)

  @@map("creator_payout_profiles")
}

// ============ Photo & Wish Wall ============
model GuestWish {
  id            String   @id @default(uuid()) @db.Uuid
  invitation_id String   @db.Uuid
  guest_id      String?  @db.Uuid
  author_name   String
  message       String
  photo_url     String?
  is_approved   Boolean  @default(true)
  is_flagged    Boolean  @default(false)
  flag_reason   String?
  created_at    DateTime @default(now())

  invitation Invitation @relation(fields: [invitation_id], references: [id], onDelete: Cascade)
  guest      Guest?     @relation(fields: [guest_id], references: [id], onDelete: SetNull)

  @@index([invitation_id])
  @@map("guest_wishes")
}

// ============ Custom Commission Hub ============
model CustomDesignRequest {
  id           String    @id @default(uuid()) @db.Uuid
  host_user_id String    @db.Uuid
  title        String
  event_type   String
  description  String
  budget       Int
  currency     String    @default("INR")
  deadline     DateTime?
  status          String    @default("OPEN") // OPEN, IN_PROGRESS, COMPLETED, CANCELLED
  accepted_bid_id String?   @db.Uuid
  created_at      DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  host User        @relation("HostDesignRequests", fields: [host_user_id], references: [id], onDelete: Cascade)
  bids DesignBid[]

  @@index([host_user_id])
  @@index([status])
  @@map("custom_design_requests")
}

model DesignBid {
  id              String   @id @default(uuid()) @db.Uuid
  request_id      String   @db.Uuid
  creator_user_id String   @db.Uuid
  amount          Int
  proposal        String
  sample_url      String?
  delivery_days   Int      @default(3)
  status          String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  created_at      DateTime @default(now())

  request CustomDesignRequest @relation(fields: [request_id], references: [id], onDelete: Cascade)
  creator User                @relation("CreatorDesignBids", fields: [creator_user_id], references: [id], onDelete: Cascade)

  @@index([request_id])
  @@index([creator_user_id])
  @@map("design_bids")
}

// ============ Reviews & Ratings ============
model TemplateReview {
  id             String   @id @default(uuid()) @db.Uuid
  template_id    String   @db.Uuid
  user_id        String   @db.Uuid
  rating         Int // 1 to 5
  review         String?
  verified_buyer Boolean  @default(true)
  is_featured    Boolean  @default(false)
  created_at     DateTime @default(now())

  template Template @relation(fields: [template_id], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([template_id])
  @@map("template_reviews")
}

// ============ Done-for-You Concierge Service ============
model ConciergeServiceOrder {
  id            String   @id @default(uuid()) @db.Uuid
  user_id       String   @db.Uuid
  invitation_id String?  @db.Uuid
  status        String   @default("NEW") // NEW, ASSIGNED, IN_PROGRESS, REVIEW, DELIVERED
  assigned_to   String?
  notes         String?
  amount        Int      @default(999)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  user       User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  invitation Invitation? @relation(fields: [invitation_id], references: [id], onDelete: SetNull)

  @@map("concierge_orders")
}

// ============ Affiliate Program ============
model AffiliatePartner {
  id             String   @id @default(uuid()) @db.Uuid
  user_id        String   @unique @db.Uuid
  code           String   @unique
  company_name   String?
  category       String   @default("PHOTOGRAPHER") // PLANNER, PHOTOGRAPHER, DECORATOR, VENUE, OTHER
  commission_pct Int      @default(10)
  total_earned   Int      @default(0)
  total_paid     Int      @default(0)
  status         String   @default("ACTIVE")
  created_at     DateTime @default(now())

  user      User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  referrals AffiliateReferral[]

  @@map("affiliate_partners")
}

model AffiliateReferral {
  id                String   @id @default(uuid()) @db.Uuid
  affiliate_id      String   @db.Uuid
  referred_user_id  String   @db.Uuid
  order_amount      Int
  commission_amount Int
  status            String   @default("PENDING") // PENDING, APPROVED, PAID
  created_at        DateTime @default(now())

  affiliate AffiliatePartner @relation(fields: [affiliate_id], references: [id], onDelete: Cascade)

  @@index([affiliate_id])
  @@map("affiliate_referrals")
}

// ============ Trust & Safety: Copyright & Strikes ============
model CopyrightReport {
  id             String   @id @default(uuid()) @db.Uuid
  template_id    String?  @db.Uuid
  reporter_name  String
  reporter_email String
  proof_url      String
  description    String
  status         String   @default("PENDING") // PENDING, UPHELD, DISMISSED
  action_taken   String?
  created_at     DateTime @default(now())

  template Template? @relation(fields: [template_id], references: [id], onDelete: SetNull)

  @@map("copyright_reports")
}

model CreatorStrike {
  id              String   @id @default(uuid()) @db.Uuid
  creator_user_id String   @db.Uuid
  reason          String
  strike_number   Int      @default(1)
  issued_by_id    String?  @db.Uuid
  created_at      DateTime @default(now())

  creator User @relation("CreatorStrikes", fields: [creator_user_id], references: [id], onDelete: Cascade)

  @@index([creator_user_id])
  @@map("creator_strikes")
}

// ============ Operations & WhatsApp Health ============
model WhatsAppContext {
  id                   String   @id @default(uuid()) @db.Uuid
  phone_number_id      String   @unique
  display_phone_number String
  quality_rating       String   @default("GREEN") // GREEN, YELLOW, RED
  status               String   @default("CONNECTED")
  daily_limit          Int      @default(1000)
  sent_today           Int      @default(0)
  block_rate           Float    @default(0.0)
  is_primary           Boolean  @default(true)
  last_health_check    DateTime @default(now())

  @@map("whatsapp_contexts")
}

model DailyReconciliation {
  id               String   @id @default(uuid()) @db.Uuid
  date             DateTime @unique
  total_orders     Int      @default(0)
  gross_sales      Int      @default(0)
  gateway_settled  Int      @default(0)
  creator_payouts  Int      @default(0)
  platform_fee_net Int      @default(0)
  discrepancy      Int      @default(0)
  status           String   @default("MATCHED") // MATCHED, REVIEW_NEEDED
  notes            String?

  @@map("daily_reconciliations")
}

// ============ Version History & Activity Log ============
model ActivityHistory {
  id          String   @id @default(uuid()) @db.Uuid
  entity_type String   // "TEMPLATE" | "INVITATION"
  entity_id   String   @db.Uuid
  user_id     String?  @db.Uuid
  action      String   // "EDIT_CONTENT" | "UPDATE_PALETTE" | "UPDATE_PRICE" | "PUBLISH" | "IMPORT_CSV_GUESTS" | "RESTORE_VERSION"
  title       String
  description String?
  snapshot    Json?
  version_num Int      @default(1)
  created_at  DateTime @default(now())

  user User? @relation("UserActivityHistory", fields: [user_id], references: [id], onDelete: SetNull)

  @@index([entity_type, entity_id])
  @@index([user_id])
  @@map("activity_history")
}

// ============ Creator Payout Settlements ============
model CreatorPayoutRequest {
  id                    String    @id @default(uuid()) @db.Uuid
  user_id               String    @db.Uuid
  amount                Int
  whatsapp_fee_deducted Int       @default(0)
  net_payout_amount     Int
  currency              Currency  @default(INR)
  method                String    // "BANK" | "UPI"
  account_number        String?
  ifsc_code             String?
  bank_name             String?
  upi_id                String?
  status                String    @default("PENDING") // "PENDING" | "PROCESSING" | "COMPLETED" | "REJECTED"
  utr_reference         String?
  processed_at          DateTime?
  admin_notes           String?
  created_at            DateTime  @default(now())

  user User @relation("CreatorPayoutRequests", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([status])
  @@map("creator_payout_requests")
}
