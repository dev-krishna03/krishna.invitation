#   openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# Everything else (Brevo, Razorpay, Stripe, Cashfree, PhonePe, Google Maps, WhatsApp, ...)
# is stored in the DB through /admin/integrations and /admin/gateways — not env vars.
